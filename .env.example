# ── Binance SPOT Testnet keys (required for balance & orders) ──────────────
#
# IMPORTANT: Keys from https://www.binance.com will NOT work.
# You must create keys at the Spot Testnet portal:
#   https://testnet.binance.vision/
#
# Steps:
#   1. Open https://testnet.binance.vision/ and sign in (GitHub).
#   2. Click "Generate HMAC_SHA256 Key".
#   3. Copy the key and secret below (no quotes, no trailing spaces).
#   4. Save this file as ".env" in the project root.
#
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_SECRET_KEY=your_testnet_secret_key_here

# ── Telegram alerts (optional) ─────────────────────────────────────────────
#
# 1. Message @BotFather on Telegram → /newbot → copy the bot token.
# 2. Start a chat with your new bot (send any message).
# 3. Open this URL in a browser (replace YOUR_TOKEN):
#      https://api.telegram.org/botYOUR_TOKEN/getUpdates
#    Find "chat":{"id":123456789} — that number is your TELEGRAM_CHAT_ID.
#
# Alerts are important-only: entries, exits, daily desk digest, halt, failures.
#
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Send the desk daily summary once at/after this UTC hour (0–23).
TELEGRAM_DAILY_HOUR=21

# ── Paper capital (matches what you'd fund later with real money) ───────────
# All three desks default to $100. QQQ uses fractional shares (no $500 futures margin).
# Crypto display/sizing is capped vs larger Binance testnet faucet balances.
ORBIT_PAPER_EQUITY=100
GOLD_PAPER_EQUITY=100
MNQ_PAPER_EQUITY=100

# ── Paper friction (simulate retail real-money costs) ───────────────────────
# Crypto: floor fee/slip when Binance testnet undercharges vs live retail.
# Applied once via the spot cash ledger (paper_cash_usdt) — not a second drag.
ORBIT_FEE_RATE=0.001
ORBIT_SLIPPAGE_BPS=5
# Gold CFD/futures proxy — all-in cost + adverse slip per side.
GOLD_COST_BPS=2.0
GOLD_SLIPPAGE_BPS=1.0
# QQQ ETF desk (mnq_bot) — bps of notional per side.
QQQ_COST_BPS=1.0
QQQ_SLIPPAGE_BPS=2.0
# Legacy aliases still accepted by paper.costs (optional):
# MNQ_COST_BPS=1.0
# MNQ_SLIPPAGE_BPS=2.0

# ── Cloud / Oracle hosting ─────────────────────────────────────────────────
# Dashboard password for http://YOUR_VM_IP:8080 (change if the site is public).
ORBIT_DASHBOARD_PASSWORD=change-me
# ORBIT_HEADLESS=1
# ORBIT_AUTOSTART=1
# ORBIT_HOST=0.0.0.0
# ORBIT_PORT=8080

